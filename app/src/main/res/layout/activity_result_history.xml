<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBackFromHistory"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="◀"
            android:textSize="14sp"
            android:backgroundTint="#2C2C2C"
            android:padding="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Scan History"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="📥 Export CSV"
            android:textSize="11sp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Search by Roll Number -->
    <EditText
        android:id="@+id/etSearchRoll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="#1E1E1E"
        android:hint="🔍 Search by Roll Number..."
        android:textColor="#FFFFFF"
        android:textColorHint="#757575"
        android:textSize="14sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="text" />

    <!-- Exam Filter Spinner -->
    <Spinner
        android:id="@+id/spnExamFilter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E" />

    <!-- Results count -->
    <TextView
        android:id="@+id/tvResultsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0 results found"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <!-- Results ListView -->
    <ListView
        android:id="@+id/lvResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="#242424"
        android:dividerHeight="8dp" />

</LinearLayout>

