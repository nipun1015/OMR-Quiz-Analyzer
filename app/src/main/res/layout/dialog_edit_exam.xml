<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Examination"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Exam Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Examination Name"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etExamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Midterm Quiz"
            android:textColor="#FFFFFF"
            android:textColorHint="#616161"
            android:backgroundTint="#00E676"
            android:inputType="textCapWords" />

        <!-- Marking Scheme -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marks / Correct"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etMarksCorrect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1.0"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#00E676"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Negative Marks"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etNegativeMarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0.25"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF5252"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Answer Keys Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Answer Key (15 Questions, Option 2 layout):"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Group 1 (Q1-5) • Group 2 (Q6-10) • Group 3 (Q11-15)"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />

        <!-- 15 Questions Container -->
        <LinearLayout
            android:id="@+id/llQuestionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelEdit"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancel"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSaveExam"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:text="Save Exam"
                android:backgroundTint="#00C853"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

