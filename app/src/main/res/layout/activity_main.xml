<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Live camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter">

    </androidx.camera.view.PreviewView>

    <!-- 2. Frozen snapshot view (instant freeze on click to avoid hand shake) -->
    <ImageView
        android:id="@+id/capturedImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 3. Transparent alignment guide overlay with 160 coloured dots -->
    <com.example.omrscanner.AlignmentOverlayView
        android:id="@+id/alignmentOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 4. Top instruction & legend header -->
    <LinearLayout
        android:id="@+id/topHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackToHome"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:backgroundTint="#424242"
                android:padding="0dp"
                android:text="◀"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActiveExamHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Exam: UCS420 Quiz"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/instructionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Align the printed OMR bubbles with the coloured guide dots before capturing."
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleDebug"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#1976D2"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Debug: ON"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● 100 Roll Bubbles (Red)"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="● 60 Answer Bubbles (Green)"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/calibrationStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="Hint: Drag to move • Pinch to zoom • Tap Capture to freeze"
            android:textColor="#B0BEC5"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- 5. Collapsible Overlay Adjustment Controls Panel -->
    <LinearLayout
        android:id="@+id/calibrationControlsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="110dp"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Overlay Fine Tune"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Move Up -->
        <Button
            android:id="@+id/btnMoveUp"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:padding="0dp"
            android:text="▲"
            android:textSize="12sp" />

        <!-- Move Left / Reset / Move Right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMoveLeft"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:text="◀"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnResetCalibration"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:text="Reset"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnMoveRight"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:text="▶"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Move Down -->
        <Button
            android:id="@+id/btnMoveDown"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:padding="0dp"
            android:text="▼"
            android:textSize="12sp" />

        <!-- Scale / Zoom Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnZoomOut"
                android:layout_width="66dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:text="Size −"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnZoomIn"
                android:layout_width="66dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:padding="0dp"
                android:text="Size ＋"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Calibration toggle button -->
        <Button
            android:id="@+id/btnToggleControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adjust ⚙"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Capture button -->

        <Button
            android:id="@+id/captureButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:backgroundTint="#00C853"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="📷  Capture &amp; Freeze"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Lock / unlock overlay position -->
        <Button
            android:id="@+id/btnLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔓 Lock"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- 7. Large Countdown Indicator -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textColor="#00E676"
        android:textSize="72sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 8. Processing Progress overlay -->
    <LinearLayout
        android:id="@+id/llProcessingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Image frozen. Evaluating with OpenCV..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
