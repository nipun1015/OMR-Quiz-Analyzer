<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBackFromExams"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:text="◀"
            android:textSize="14sp"
            android:backgroundTint="#2C2C2C"
            android:padding="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Examinations"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCreateExam"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="＋ New Exam"
            android:textSize="12sp"
            android:backgroundTint="#00C853"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Select an exam to make active, or edit its 15-question answer key."
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <!-- Exam List -->
    <ListView
        android:id="@+id/lvExams"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:divider="#242424"
        android:dividerHeight="8dp" />

</LinearLayout>

